{
  "name": "elephantology-wiki",
  "version": "1.0.0",
  "description": "Энциклопедия «Слонология» - База знаний о слонах",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "build:library": "tsx scripts/build-library.ts --docs=./docs --public=./public --out=./dist/library --site=https://drinkbeer228.github.io/elephantology",
    "build": "vite build && node seo-helper.js --docs=./docs --domain=https://drinkbeer228.github.io/elephantology --out=./dist/sitemap.xml && node prerender.js --docs=./docs --domain=https://drinkbeer228.github.io/elephantology && npm run build:library",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.10",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "motion": "^13.1.1",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.2",
    "image-size": "^2.1.0",
    "postcss": "^8.5.26",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
