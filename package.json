{
  "name": "elephantology-wiki",
  "version": "1.0.0",
  "description": "Энциклопедия «Слонология» - База знаний о слонах",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "vite build && node seo-helper.js --docs=./docs --domain=https://elephantology.ai.studio --out=./dist/sitemap.xml && node prerender.js",
    "lint": "eslint . && npm run typecheck",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "^1.2.16",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "highlight.js": "^11.12.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.33.0",
    "marked": "^18.1.3",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "p-limit": "^7.3.3",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0"
