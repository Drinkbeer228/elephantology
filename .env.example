# Port for the dev/preview Express server (npm run dev)
PORT=3000

# Canonical origin for SEO tags, sitemap and og:url.
# Leave empty to use the default (https://elephantology.github.io).
# Set when deploying elsewhere, e.g.:
#   SITE_ORIGIN=https://<user>.github.io/<repo>     # GitHub Pages project site
#   SITE_ORIGIN=https://elephantology.onrender.com  # Render free tier
SITE_ORIGIN=

# Legacy alias — if set, server.js uses https://$PROJECT_DOMAIN as SITE_ORIGIN.
# PROJECT_DOMAIN=elephantology.github.io

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
